{
    "name": "dnd-playlist-server",
    "version": "1.0.0",
    "description": "Shared YouTube playlist browser for D&D sessions",
    "scripts": {
        "typeTest": "npm run type:server && npm run type:legacy && npm run type:client && npm run type:shared",
        "test": "jest --runInBand",
        "test:watch": "jest --watchAll --runInBand",
        "test:ci": "jest --ci --runInBand",
        "test:coverage": "jest --ci --runInBand --coverage",
        "test:types": "tsc --project tsconfig.test.json --noEmit",
        "test:browser": "playwright test",
        "test:browser:types": "tsc --project tsconfig.browser-tests.json --noEmit",
        "test:browser:install": "node browser-tests/install.cjs",
        "test:start": "node tests/smoke-start.cjs",
        "check": "npm run lint && npm run typeTest && npm run test:types && npm run test:browser:types && npm run test:coverage",
        "test:all": "npm run check && npm run test:browser",
        "bench:cache": "node --expose-gc benchmarks/cache.cjs",
        "bundle:createList": "npm run build:legacy",
        "dev:server": "nodemon --config nodemon.json",
        "dev:watch": "node bin/bundle.cjs --watch",
        "dev": "npm run typeTest && node bin/dev.cjs",
        "build": "node bin/build.cjs",
        "start": "node dist/server/routes/app.js",
        "urlCheck": "node dist/server/agents/loadUrl",
        "lint": "eslint --ext .ts,.tsx src client/src tests browser-tests playwright.config.ts --max-warnings 0",
        "lint:fix": "npm run lint -- --fix",
        "getCounts": "node dist/server/agents/getListCounts",
        "fetchLists": "node dist/server/utilities/fetchPlaylists",
        "bench:sqlite": "node --expose-gc benchmarks/sqlite-store.cjs",
        "test:runtime": "node tests/smoke-runtime.cjs",
        "prebuild": "node bin/require-runtime.cjs",
        "predev": "node bin/require-runtime.cjs",
        "prestart": "node bin/require-runtime.cjs",
        "precheck": "node bin/require-runtime.cjs",
        "type:server": "tsc --project tsconfig.server.json --noEmit",
        "type:legacy": "tsc --project tsconfig.legacy.json --noEmit",
        "type:client": "tsc --project tsconfig.client.json --noEmit",
        "type:shared": "tsc --project tsconfig.shared.json --noEmit",
        "build:server": "node bin/build.cjs server",
        "build:legacy": "node bin/build.cjs legacy",
        "build:client": "node bin/build.cjs client",
        "test:build": "node tests/build-isolation.cjs",
        "test:client": "node tests/smoke-start.cjs --browser"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patientsomeone/dnd-playlist-server.git"
    },
    "keywords": [
        "dnd",
        "youtube",
        "playlists"
    ],
    "author": "Joshua Robinson",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/patientsomeone/dnd-playlist-server/issues"
    },
    "homepage": "https://github.com/patientsomeone/dnd-playlist-server#readme",
    "dependencies": {
        "@googleapis/youtube": "^40.0.2",
        "async": "^3.2.6",
        "atob": "^2.1.2",
        "axios": "^1.21.0",
        "axios-cookiejar-support": "^7.0.0",
        "btoa": "^1.2.1",
        "cors": "^2.8.6",
        "debug": "^4.4.3",
        "dotenv": "^18.0.9",
        "edit-json-file": "^1.8.1",
        "express": "^5.3.0",
        "JSONStream": "^1.3.5",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sqlite3": "^6.0.1",
        "tough-cookie": "^6.0.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/async": "^3.2.26",
        "@types/atob": "^2.1.4",
        "@types/btoa": "^1.2.5",
        "@types/cors": "^2.8.19",
        "@types/debug": "^4.1.13",
        "@types/edit-json-file": "^1.7.4",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonstream": "^0.8.33",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/youtube": "^0.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "nodemon": "^3.1.14",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3"
    },
    "allowScripts": {
        "sqlite3": true,
        "esbuild": true
    },
    "engines": {
        "node": ">=24.22.1 <25",
        "npm": ">=11.19.1 <12"
    },
    "packageManager": "npm@11.19.1",
    "private": true
}
