{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "lib": ["es2024", "dom", "dom.iterable"],
        "types": [
            "node"
        ],
        "resolveJsonModule": true,
        "noEmit": true,
        "target": "es2024"
    },
    "include": [
        "browser-tests/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
