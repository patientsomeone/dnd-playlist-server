{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024", "dom", "dom.iterable"],
        "rootDir": ".",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "isolatedModules": true,
        "types": [
            "node",
            "jest",
            "youtube"
        ],
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": [
        "tests/**/*.ts",
        "tests/fixtures/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
