{
    "extends": "./tsconfig.base.json",
    "compileOnSave": false,
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "jsx": "react-jsx",
        "allowArbitraryExtensions": true,
        "lib": [
            "es2020",
            "dom",
            "dom.iterable"
        ],
        "types": [
            "node",
            "youtube"
        ],
        "rootDir": ".",
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "client/src/**/*.ts",
        "client/src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.spec.ts",
        "src/logs"
    ]
}
